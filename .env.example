# ---------------------------------------------------------------------------
# Repo-Pulse — environment variables
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. The `.env` file is
# gitignored; never commit secrets.
#
# Format: only `KEY=value` lines. python-dotenv does NOT understand the
# `KEY: type = "value"` form — pydantic-settings will silently fall back
# to in-code defaults if a value can't be parsed.

# GitHub Personal Access Token (fine-grained, public-only scopes are enough).
# Required for the Collector to authenticate to the REST API.
GITHUB_TOKEN=ghp_replace_me

# HTTP Basic Auth credentials for the dashboard (handled at the nginx layer;
# the app never sees them). Used only to generate the htpasswd entry on
# first deploy.
BASIC_AUTH_USER=replace_me
BASIC_AUTH_PASS=replace_me
